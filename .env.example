# Supabase (public browser configuration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only credentials — never expose these in browser code
SUPABASE_SECRET_KEY=
OPENCODE_GO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GITHUB_WORKER_TOKEN=
GITHUB_WORKER_REPOSITORY=MarvanGit/WerkMatch
GITHUB_DOCUMENT_WORKFLOW=document-worker.yml
GITHUB_WORKER_BRANCH=main
LINKEDIN_ENABLED=true
# The scheduled GitHub workflow uses a larger LinkedIn budget.
LINKEDIN_MAX_SEARCH_PAGES=12
LINKEDIN_MAX_CANDIDATES=240
LINKEDIN_MAX_RUNTIME_SECONDS=480

# Matching defaults
MAX_EVALUATIONS_PER_RUN=20
OPENCODE_MATCH_MODEL=gpt-5.6-luna
OPENCODE_DOCUMENT_MODEL=gpt-5.6-luna
COVER_LETTER_TEMPLATE_OBJECT_KEY=
JOB_SEARCH_INTERVAL_HOURS=6
MATCH_NOTIFICATION_THRESHOLD=75
SIEMENS_MAX_SEARCH_PAGES=12
SIEMENS_MAX_CANDIDATES=64
SIEMENS_HEALTHINEERS_MAX_PAGES=4
